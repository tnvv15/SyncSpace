# Environment variables example

# Shared PostgreSQL connection used by the Express backend and Prisma.
# Set this to the SAME value in the private .env file on every PC that should
# use the shared database. Replace every placeholder; do not commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Local Docker fallback only. These values configure docker-compose.yml when
# you choose to run a private PostgreSQL instance with Docker. For that setup,
# set DATABASE_URL to the matching localhost URL in your private .env instead.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=syncspace

# Example only -- local Docker fallback, not the shared-database setting:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/syncspace?schema=public"

# JWT Secret for authentication
JWT_SECRET="syncspace-dev-secret-change-in-prod"

# Frontend URL for development
FRONTEND_URL="http://localhost:5173"

# Client URL for CORS
CLIENT_URL="http://localhost:5173"

# Server port
PORT="5000"

# Yjs WebSocket relay used by the Vite client (not the Express API)
VITE_YJS_WS_URL="ws://localhost:1234"
